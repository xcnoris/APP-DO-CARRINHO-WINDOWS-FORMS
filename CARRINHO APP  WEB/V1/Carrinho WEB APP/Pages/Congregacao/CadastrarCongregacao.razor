@page "/cadastrar-congregacao"

@inject Carrinho_API carrinho_API
@inject CongregacaoAPI congregacaoAPI
@inject NavigationManager navigationManager


<MudPaper Class="px-8 pt-2 pb-4 mx-12 my-8" Justify="Justify.Center">

    <MudText Class="mt-8" Typo="Typo.h4">Cadastro de Congregação</MudText>

    <MudForm>

        <MudTextField Class="mt-4" T="string" Placeholder="Nome Congregação"
                      Variant="Variant.Outlined"
                      @bind-Value="Nome_Congregacao"
                      Required="true"
                      RequiredError="Campo obrigatório." />


        <MudSelect Class="mt-4" T="SituacaoGeral" Label="Situação" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" @bind-Value="Situacao">
            @foreach (var situacao in Enum.GetValues(typeof(SituacaoGeral)).Cast<SituacaoGeral>())
            {
                <MudSelectItem Value="situacao">@GetEnumDescription(situacao)</MudSelectItem>
            }
        </MudSelect>




        <div class=" align-center justify-space-between mt-4">
            <MudButton Variant="Variant.Filled"
                       @onclick="Cadastrar"
                       Color="Color.Tertiary"
                       Class="ml-auto">
                Cadastrar
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       @onclick="VoltarToCongregacoes"
                       Color="Color.Primary"
                       Class="ml-auto">
                Voltar
            </MudButton>
        </div>

    </MudForm>
</MudPaper>

@code {
    private string Nome_Congregacao { get; set; }
    private SituacaoGeral Situacao { get; set; }
    private CongregacaoModel Congregacao { get; set; }

    // Pega os valores das descrição do Enum
    private string GetEnumDescription(SituacaoGeral situacao)
    {
        var fieldInfo = situacao.GetType().GetField(situacao.ToString());
        var descriptionAttributes = (DescriptionAttribute[])fieldInfo.GetCustomAttributes(typeof(DescriptionAttribute), false);

        return descriptionAttributes.Length > 0 ? descriptionAttributes[0].Description : situacao.ToString();
    }
    private ICollection<CongregacaoModel>? congregacoes;

    protected override async Task OnInitializedAsync()
    {
        congregacoes = await congregacaoAPI.GetTodasCongregacoesAsync();
    }

    private void VoltarToCongregacoes()
    {
        navigationManager.NavigateTo("/Congregacoes");
    }

    private async void Cadastrar()
    {
        try
        {
            // Cria o objeto CarrinhoModel
            var request = new CongregacaoModel()
                {
                    Nome = Nome_Congregacao!,
                    Situacao = Situacao
                };

            request.ValidarClasse();

            await congregacaoAPI.AddAsync(request);

            VoltarToCongregacoes();

            Console.WriteLine("Carrinho cadastrado com sucesso!");
        }
        catch (ValidationException ex)
        {
            // Exibe as mensagens de erro de validação
            Console.WriteLine($"Erro ao cadastrar carrinho: {ex.Message}");
        }
        catch (Exception ex)
        {
            // Captura outras exceções
            Console.WriteLine($"Erro inesperado: {ex.Message}");
        }
    }
}

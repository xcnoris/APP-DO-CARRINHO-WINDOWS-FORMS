@inject Carrinho_API carrinhoAPI

@page "/Carrinho"

<h1>Carrinho</h1>
<MudSimpleTable  Striped=true Style="overflow-x: auto;">
    <thead>
        <tr>
            @foreach (var h in headings)
            {
                <th>@h</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var car in carrinho)
        {
            <tr>
                <td>@car.Id</td>
                <td>@car.Nome</td>
                <td>@car.Codigo_Carrinho</td>
                <td>@car.Situacao</td>
                <td>@car.Congregacao.Nome</td>
                <td>@car.DataCriacao</td>

            </tr>
        }
    </tbody>
</MudSimpleTable>


@code {
    private ICollection<CarrinhoModel>? carrinho;
    private string? errorMessage;

    string[] headings = { "ID", "Nome", "Codigo Carrinho", "Situacao", "Congregação","Data de Criação" };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            carrinho = await carrinhoAPI.GetTodosCarrinhoAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Erro ao carregar carrinhos: " + ex.Message;
            Console.WriteLine($"Erro ao buscar Carrinho: {ex.Message}");
        }
    }
}
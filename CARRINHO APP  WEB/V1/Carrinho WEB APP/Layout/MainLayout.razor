@inherits LayoutComponentBase

@inject NavigationManager NavigationManager

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />



<MudLayout>
    <MudAppBar Color="Color.Surface" Fixed="true" Elevation="1">

        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6"><MudButton Variant="Variant.Text" OnClick="NavigateHome" Color="Color.Inherit">Carrinho Web App</MudButton></MudText>
        <MudSpacer />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" Link="https://github.com/eric-king/trackor/" Target="_blank" />

    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Mini" ClipMode="DrawerClipMode.Always" Elevation="1">
        <NavMenu></NavMenu>
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<MudPopoverProvider></MudPopoverProvider>


@code{

    bool themeLoading = true;
    bool _drawerOpen = true;
    private void NavigateHome() => NavigationManager.NavigateTo("/");
    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}


